---
const { active = 'home' } = Astro.props;
const nav = [
  { title: 'Home', href: '/', key: 'home', icon: '<path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"/>' },
  { title: 'Search', href: '/explore', key: 'explore', icon: '<circle cx="10.8" cy="10.8" r="7.3"/><path d="m16.2 16.2 4.3 4.3"/>' },
  { title: 'Booking', href: '/bookings', key: 'bookings', icon: '<rect x="3.5" y="5" width="17" height="16" rx="2"/><path d="M8 3v4m8-4v4M3.5 10h17m-9 4v5m-2.5-2.5h5"/>' },
  { title: 'Message', href: '/notifications', key: 'notifications', icon: '<path d="M21 11.5a8.4 8.4 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.4 8.4 0 0 1-3.8-.9L3 21l1.9-5.7a8.4 8.4 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.4 8.4 0 0 1 3.8-.9h.5a8.5 8.5 0 0 1 8 8z"/><path d="M8 12h.01M12 12h.01M16 12h.01"/>' },
  { title: 'Profile', href: '/bookings', key: 'profile', icon: '<circle cx="12" cy="8" r="4"/><path d="M5 21v-1a7 7 0 0 1 14 0v1z"/>' },
];
---
<nav class="mobile-nav" aria-label="Mobile navigation">
  {nav.map((item) => (
    <a href={item.href} class:list={[active === item.key && item.key !== 'bookings' ? 'active' : '', item.key === 'bookings' ? 'book-tab' : '']} aria-label={item.title} aria-current={active === item.key ? 'page' : undefined}>
      <svg width="23" height="23" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={item.icon}></svg>
      {item.key === 'notifications' && <span class="nav-dot" aria-hidden="true"></span>}
      <span>{item.title}</span>
    </a>
  ))}
</nav>
