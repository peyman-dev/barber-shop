---
import MainLayout from '@/layouts/MainLayout.astro';
import SalonCard from '@/components/ui/SalonCard.astro';
import { salons } from '@/data/salons';
const categories = [{ name: 'Haircuts', icon: '✂' }, { name: 'Coloring', icon: '▰' }, { name: 'Smoothing', icon: '◉' }, { name: 'Shaving', icon: '〰' }];
---
<MainLayout title="Barberly — Find your next great cut" description="Discover trusted local barbers, explore services and plan your next appointment." active="home">
  <section class="home-hero">
    <div class="shell hero-inner">
      <div class="hero-copy"><p class="hero-greeting">Hi, Raphinha <span aria-hidden="true">👋</span></p><h1>Let’s find your top<br class="desktop-break"/> Barbershop!</h1><p class="hero-description">A great cut starts with the right barber. Find your next favourite around you.</p>
        <a class="hero-search" href="/explore"><svg width="23" height="23" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="10.8" cy="10.8" r="7.3"/><path d="m16.2 16.2 4.3 4.3"/></svg><span>Search services or barbershop</span><kbd>⌘ K</kbd></a>
      </div>
      <div class="hero-visual"><img src="/images/barbershop-hero.jpg" alt="A barber at work in a contemporary barbershop" width="560" height="360" fetchpriority="high"/><div class="visual-caption"><span>✦</span><div><strong>Your next great cut awaits</strong><small>Explore top-rated barbers nearby</small></div></div></div>
    </div>
  </section>
  <div class="shell page-content home-content">
    <section class="upcoming-section">
      <div class="section-heading"><div><span class="eyebrow">Next appointment</span><h2>Upcoming service</h2></div><a href="/bookings">View booking</a></div>
      <a class="upcoming-card card" href="/booking-details"><img src="/images/classic-haircut.jpg" alt="Classic haircut in progress" width="92" height="112"/><div class="upcoming-copy"><h3>Classic Cuts Barber Shop</h3><p>December 23, 2025 · 10:30 AM</p><strong>Services:</strong><span>Hair Repair Treatment &amp; Smoothing</span></div><span class="appointment-state">Confirmed</span></a>
    </section>
    <section><div class="section-heading"><h2>Service categories</h2><a href="/services/haircuts">See all</a></div><div class="category-grid">{categories.map((category) => <a class="category-card" href="/services/haircuts"><span class="category-icon">{category.icon}</span><span>{category.name}</span></a>)}</div></section>
    <section><div class="section-heading"><div><span class="eyebrow">Handpicked near you</span><h2>Nearby your location</h2></div><a href="/explore">See all</a></div><div class="nearby-grid">{salons.slice(0, 3).map((salon) => <SalonCard salon={salon} />)}</div></section>
    <section class="service-nearby"><div class="section-heading"><h2>Nearby location</h2><a href="/explore">See all</a></div><div class="service-chips"><a class="pill active" href="/explore">All services</a><a class="pill" href="/services/haircuts">Haircuts</a><a class="pill" href="/services/haircuts">Coloring</a><a class="pill" href="/services/haircuts">Smoothing</a></div><div class="nearby-grid">{salons.slice(2, 5).map((salon) => <SalonCard salon={salon} />)}</div></section>
  </div>
</MainLayout>
<style>
.home-hero{background:#48858c;color:white}.hero-inner{display:grid;grid-template-columns:1fr .92fr;align-items:center;gap:50px;padding-block:50px 58px}.hero-copy{padding:12px 0}.hero-greeting{margin:0 0 14px;color:#dcebed;font-size:14px}.hero-copy h1{margin:0;font-size:clamp(34px,4.3vw,54px);line-height:1.12;letter-spacing:-.055em}.hero-description{max-width:410px;margin:18px 0 26px;color:#e1eff0;font-size:16px}.hero-search{display:flex;align-items:center;gap:14px;width:min(100%,510px);height:58px;padding:0 17px;border-radius:999px;background:#fff;color:#8791a2}.hero-search span{flex:1}.hero-search kbd{padding:4px 7px;border:1px solid #e5e8ed;border-radius:6px;color:#97a0ae;font-size:11px}.hero-visual{position:relative;overflow:hidden;height:300px;border-radius:22px}.hero-visual:after{content:'';position:absolute;inset:35% 0 0;background:linear-gradient(transparent,#1119)}.hero-visual img{width:100%;height:100%;object-fit:cover}.visual-caption{position:absolute;z-index:1;left:20px;bottom:17px;display:flex;align-items:center;gap:12px}.visual-caption>span{color:#f4be6a;font-size:28px}.visual-caption div{display:grid}.visual-caption small{color:#e1e6e8}.home-content{padding-top:18px}.section-heading h2{margin-top:3px}.upcoming-section .section-heading{margin-top:5px}.upcoming-card{display:flex;align-items:center;gap:16px;padding:14px;position:relative}.upcoming-card img{width:90px;height:112px;object-fit:cover;border-radius:13px}.upcoming-copy{display:grid;gap:4px}.upcoming-copy h3{font-size:15px;margin:0}.upcoming-copy p,.upcoming-copy span{margin:0;color:#8290a2}.upcoming-copy strong{font-size:13px;color:#7c879b;margin-top:2px}.appointment-state{margin-left:auto;align-self:flex-start;border-radius:20px;padding:6px 11px;background:#ecf5f0;color:#408363;font-size:12px;font-weight:650}.category-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}.category-card{display:flex;flex-direction:column;align-items:center;gap:9px;color:#313944;font-weight:600}.category-icon{display:grid;place-items:center;width:67px;height:67px;border-radius:50%;background:#eaf2f3;color:#48858c;font-size:24px}.nearby-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}.service-chips{display:flex;gap:9px;overflow:auto;margin:-2px 0 14px;scrollbar-width:none}.service-chips::-webkit-scrollbar{display:none}.service-chips .pill{font-size:13px}.service-chips .pill.active{background:#eaf2f3;color:#48858c}.nearby-grid .salon-card{align-items:flex-start;flex-direction:column;padding:12px}.nearby-grid .salon-card img{width:100%;height:155px;flex-basis:auto}.nearby-grid .salon-info{width:100%}.nearby-grid .salon-info p{white-space:normal;min-height:20px}.nearby-grid .meta-row{font-size:12px;gap:6px 10px}@media(max-width:767px){.home-hero{position:relative;border-radius:0 0 0 0}.hero-inner{display:block;padding-block:20px 118px;width:100%}.hero-copy{width:calc(100% - 46px);margin:auto}.hero-greeting{margin:0 0 5px;font-size:13px}.hero-copy h1{font-size:19px;line-height:1.45;letter-spacing:-.02em}.hero-description{display:none}.hero-search{height:52px;margin-top:20px;font-size:13px}.hero-search kbd{display:none}.hero-visual{display:none}.home-content{padding-top:0}.upcoming-section{margin-top:-82px;position:relative}.upcoming-section .section-heading{margin-bottom:14px}.upcoming-section .section-heading > div .eyebrow{display:none}.section-heading h2{font-size:17px}.upcoming-card{min-height:150px;padding:12px;border-radius:16px;align-items:flex-start}.upcoming-card img{width:78px;height:122px}.upcoming-copy{gap:5px}.upcoming-copy h3{font-size:14px}.upcoming-copy p,.upcoming-copy span{font-size:13px;line-height:1.6}.appointment-state{display:none}.category-grid{gap:5px}.category-icon{width:56px;height:56px;font-size:20px}.category-card{font-size:13px}.nearby-grid{grid-template-columns:1fr;gap:14px}.nearby-grid .salon-card{flex-direction:row;align-items:center;padding:13px}.nearby-grid .salon-card img{width:78px;height:78px;flex-basis:78px}.nearby-grid .salon-info p{min-height:0;white-space:nowrap}.nearby-grid .meta-row{font-size:13px;gap:7px 13px}.home-content>section:last-child{margin-bottom:18px}}
</style>
